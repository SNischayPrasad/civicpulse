# ---------------------------------------------------------------
# CivicPulse environment
# ---------------------------------------------------------------
PORT=4000
JWT_SECRET=civicpulse-infinity-force-dev-secret-change-me
NODE_ENV=development

# --- AI VISION PROVIDER -----------------------------------------
# AI_PROVIDER options:
#   auto      -> try the remote model, fall back to the on-board engine (default)
#   local     -> force the built-in CivicVision engine (no internet needed)
#   openai    -> OpenAI-compatible /v1/chat/completions vision endpoint
#   anthropic -> Anthropic Messages API
#   gemini    -> Google Generative Language API
AI_PROVIDER=auto

# The key you supplied. Set AI_BASE_URL + AI_MODEL to match its vendor.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Examples (uncomment ONE set):
# AI_PROVIDER=anthropic
# AI_API_KEY=sk-ant-...
# AI_MODEL=claude-sonnet-5
#
# AI_PROVIDER=openai
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# --- GEO / OPEN DATA --------------------------------------------
# Reverse geocoding (OpenStreetMap Nominatim) and contractor lookup (Overpass).
# Set to false for fully offline demo mode.
ENABLE_REVERSE_GEOCODE=true
ENABLE_OSM_CONTRACTORS=true
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- POLICY -----------------------------------------------------
MIN_PHOTOS=1
MAX_PHOTOS=4
AI_CONFIDENCE_THRESHOLD=0.55
DUPLICATE_RADIUS_M=70
SLA_TICK_MS=60000
